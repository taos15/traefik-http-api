# Rust server settings. Create data/ before first launch.
DOMAIN=example.com
DATABASE_URL=sqlite://data/traefik.db
LISTEN_ADDR=0.0.0.0:4000
# Required only for the first boot; set a unique password with at least 12 characters.
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-unique-long-password
# App and Traefik must share this custom Docker network and resolve container names.
TRAEFIK_NETWORK=proxynet
# Local discovery uses this app's HOSTNAME and fixed /var/run/docker.sock mount.
# A read-only socket bind does not restrict Docker API access; discovery only reads.
# Optional when Traefik's API isn't on http://<traefik-container>:8080.
# TRAEFIK_API_URL=http://traefik:8080
# TRAEFIK_API_USERNAME=internal
# TRAEFIK_API_PASSWORD=replace-with-a-unique-password
# TRAEFIK_API_PASSWORD_FILE=/run/secrets/traefik-api-password
# Optional authentication for Traefik HTTP provider GET (no anonymous fallback if set).
# PROVIDER_TOKEN=replace-with-a-random-secret
